# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y16 [get_cells u_hdmi_rx/u_BUFG_1]
set_property LOC BUFGCTRL_X0Y1 [get_cells u_dvi_transmitter_top/u_tmds_clock/serial_clk_5x_BUFG_inst]
set_property LOC BUFGCTRL_X0Y2 [get_cells sys_clk_IBUF_BUFG_inst]
set_property LOC BUFGCTRL_X0Y0 [get_cells OSERDESE2_Master_i_1]
set_property LOC BUFGCTRL_X0Y3 [get_cells cur_state_reg[7]_i_2]

# Location of IO Primitives which is load of clock spine

# Location of clock ports
set_property LOC IOB_X0Y172 [get_ports hdmi_clk_in]
set_property LOC IOB_X1Y124 [get_ports sys_clk]

# Clock net "u_hdmi_rx/pclk" driven by instance "u_hdmi_rx/u_BUFG_1" located at site "BUFGCTRL_X0Y16"
#startgroup
create_pblock {CLKAG_u_hdmi_rx/pclk}
add_cells_to_pblock [get_pblocks  {CLKAG_u_hdmi_rx/pclk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=u_dvi_transmitter_top/u_tmds_clock/mmcm_adv_inst} -of_object [get_pins -leaf -filter {DIRECTION==IN} -of_objects [get_nets {u_hdmi_rx/pclk}]]]
resize_pblock [get_pblocks {CLKAG_u_hdmi_rx/pclk}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X0Y2:CLOCKREGION_X0Y2 CLOCKREGION_X0Y3:CLOCKREGION_X0Y3 CLOCKREGION_X0Y4:CLOCKREGION_X0Y4 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1 CLOCKREGION_X1Y2:CLOCKREGION_X1Y2 CLOCKREGION_X1Y3:CLOCKREGION_X1Y3 CLOCKREGION_X1Y4:CLOCKREGION_X1Y4}
#endgroup

# Clock net "u_dvi_transmitter_top/u_tmds_clock/serial_clk_5x_BUFG" driven by instance "u_dvi_transmitter_top/u_tmds_clock/serial_clk_5x_BUFG_inst" located at site "BUFGCTRL_X0Y1"
