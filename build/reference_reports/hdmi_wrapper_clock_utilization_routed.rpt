add_cells_to_pblock [get_pblocks  {CLKAG_u_dvi_transmitter_top/u_tmds_clock/serial_clk_5x_BUFG}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -leaf -filter {DIRECTION==IN} -of_objects [get_nets {u_dvi_transmitter_top/u_tmds_clock/serial_clk_5x_BUFG}]]]
resize_pblock [get_pblocks {CLKAG_u_dvi_transmitter_top/u_tmds_clock/serial_clk_5x_BUFG}] -add {CLOCKREGION_X0Y3:CLOCKREGION_X0Y3}
#endgroup

